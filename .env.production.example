ARK_VIRTUAL_ASSET_GROUP_NAME=jingchuang-ai-virtual-assets
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_REGION=cn-beijing
VOLC_OPENAPI_ENDPOINT=https://open.volcengineapi.com

KIE_API_KEY=
