# Copy this file to .env before running docker compose on a server.
# Keep .env out of git.

MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3308
MYSQL_ROOT_PASSWORD=change_me_to_a_long_random_password
DB_NAME=jingchuang_ai

FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8088
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=9080

# Empty means same-origin requests through the frontend Nginx proxy.
VITE_API_BASE_URL=

DEFAULT_DEMO_CREDITS=100

KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_IMAGE_MODEL=nano-banana-2
KIE_DIGITAL_HUMAN_MODEL=kling/ai-avatar-pro
KIE_DIGITAL_HUMAN_RESOLUTION=720p
KIE_DIGITAL_HUMAN_DURATION=5
KIE_IMAGE_DIGITAL_HUMAN_PRIMARY_MODEL=kling/ai-avatar-pro
KIE_IMAGE_DIGITAL_HUMAN_FALLBACK_MODEL=kling/ai-avatar-pro
KIE_IMAGE_DIGITAL_HUMAN_RESOLUTION=480p
KIE_IMAGE_DIGITAL_HUMAN_FALLBACK_RESOLUTION=720p
KIE_MOTION_TRANSFER_MODEL=kling-3.0/motion-control
KIE_MOTION_TRANSFER_RESOLUTION=720p
KIE_MOTION_TRANSFER_CHARACTER_ORIENTATION=image
KIE_MOTION_TRANSFER_POINTS=100
KIE_FACE_SWAP_MODEL=wan/2-7-r2v
KIE_FACE_SWAP_RESOLUTION=720p
KIE_FACE_SWAP_DURATION=5
KIE_FACE_SWAP_POINTS=100
KIE_WATERMARK_IMAGE_MODEL=gpt-image-2-image-to-image
KIE_WATERMARK_IMAGE_RESOLUTION=2K
KIE_WATERMARK_IMAGE_POINTS=25
KIE_WATERMARK_VIDEO_MODEL=wan/2-7-r2v
KIE_WATERMARK_VIDEO_RESOLUTION=720p
KIE_WATERMARK_VIDEO_POINTS=100
KIE_ENHANCE_IMAGE_MODEL=topaz/image-upscale
KIE_ENHANCE_VIDEO_MODEL=topaz/video-upscale
KIE_ENHANCE_UPSCALE_FACTOR=2
KIE_ENHANCE_IMAGE_POINTS=25
KIE_ENHANCE_VIDEO_POINTS=100
KIE_REMOVE_BG_IMAGE_MODEL=recraft/remove-background
KIE_REMOVE_BG_IMAGE_POINTS=25
KIE_FILE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-turbo

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus
