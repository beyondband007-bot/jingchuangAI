function FailedCanvas({ task, prompt, error, onRetry }) {
  const message = task?.error || error || "鍥剧墖鐢熸垚閬囧埌闂锛岃绋嶅悗閲嶈瘯銆?;

  return (
    <div className="image-canvas chat-canvas" role="status">
