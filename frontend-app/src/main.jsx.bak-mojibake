function getDigitalHumanPublicAvatars(list = []) {
  const merged = new Map();
  digitalHumanPublicPlaceholders.forEach((item) => merged.set(item.id, item));
  list.forEach((item) => {
    if (!merged.has(item.id)) merged.set(item.id, item);
  });
  return [...merged.values()];
}

