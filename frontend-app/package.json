{
  "name": "jingchuang-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run check:mojibake && npm run check:coverage && npm run check:history-empty-states && npm run check:history-media-loading && npm run check:media-preload && npm run check:focus-visible && npm run check:reduced-motion && npm run check:sass-imports && npm run check:redundancy && npm run check:styles && npm run check:breakpoints && npm run check:style-entrypoints",
    "dev": "vite --host 127.0.0.1",
    "dev:canvas": "npm --prefix canvas-app run dev",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build && npm run check:bundle && npm run check:features && npm run check:assets",
    "preview": "vite preview --host 127.0.0.1",
    "check:mojibake": "node ./scripts/check-mojibake.mjs",
    "check:coverage": "node ./scripts/check-style-coverage.mjs",
    "check:bundle": "node ./scripts/check-initial-bundle.mjs",
    "check:features": "node ./scripts/check-feature-bundles.mjs",
    "check:assets": "node ./scripts/check-static-assets.mjs",
    "audit:assets": "node ./scripts/audit-static-asset-references.mjs",
    "audit:style-transitions": "node ./scripts/audit-style-transitions.mjs",
    "check:redundancy": "node ./scripts/check-redundancy.mjs",
    "check:styles": "node ./scripts/check-style-system.mjs",
    "check:breakpoints": "node ./scripts/check-media-breakpoints.mjs",
    "check:style-entrypoints": "node ./scripts/check-style-entrypoints.mjs",
    "check:history-empty-states": "node ./scripts/check-history-empty-states.mjs",
    "check:history-media-loading": "node ./scripts/check-history-media-loading.mjs",
    "check:media-preload": "node ./scripts/check-media-preload.mjs",
    "check:focus-visible": "node ./scripts/check-focus-visible.mjs",
    "check:reduced-motion": "node ./scripts/check-reduced-motion.mjs",
    "check:sass-imports": "node ./scripts/check-sass-imports.mjs",
    "audit:selectors": "node ./scripts/audit-css-selectors.mjs",
    "test": "npm run test:unit && npm run test:routes",
    "test:unit": "node --test ./scripts/test-task-polling.mjs ./scripts/test-request.mjs ./scripts/test-digital-human-avatar-library.mjs",
    "test:polling": "node --test ./scripts/test-task-polling.mjs",
    "test:routes": "playwright test"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.15",
    "@vitejs/plugin-react": "^5.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "sass": "^1.101.0"
  }
}
